# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# ID of the Discord channel to post narrative updates in
# (Right-click channel > Copy Channel ID with Developer Mode enabled)
DISCORD_CHANNEL_ID=your_channel_id_here

# Anthropic API key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to WoW's chat log — used only to locate your WoW install directory.
# The bot actually reads your SavedVariables file (written on logout / /reload).
# No need to enable chat logging in WoW.
#
# Windows (retail):  C:\Program Files (x86)\World of Warcraft\_retail_\Logs\WoWChatLog.txt
# macOS (retail):    /Applications/World of Warcraft/_retail_/Logs/WoWChatLog.txt
WOW_LOG_PATH=C:\Program Files (x86)\World of Warcraft\_retail_\Logs\WoWChatLog.txt

# How often to post a narrative update (seconds). Default: 5 minutes.
NARRATIVE_INTERVAL=300

# Minimum events to collect before generating a narrative.
MIN_EVENTS=2

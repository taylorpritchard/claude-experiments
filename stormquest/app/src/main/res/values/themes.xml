<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StormQuest" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/surface</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TitleText">
        <item name="android:textSize">42sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <style name="SubtitleText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="HeaderText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GoldButton">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#0d0d1a</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="BronzeButton">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">#0d0d1a</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="RestButton">
        <item name="android:background">@drawable/btn_rest</item>
        <item name="android:textColor">#ff9999</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="QuitButton">
        <item name="android:background">@drawable/btn_quit</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="ActionButton">
        <item name="android:background">@drawable/btn_action</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="LogText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:background">@color/surface</item>
        <item name="android:padding">8dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#102050"/>
            <stroke android:width="2dp" android:color="#4488ff"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1a1a2e"/>
            <stroke android:width="1dp" android:color="#2a2a4e"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a1540"/>
            <stroke android:width="1dp" android:color="#224488"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</selector>

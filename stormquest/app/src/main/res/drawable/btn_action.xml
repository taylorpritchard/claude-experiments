<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2a3a5a"/>
            <stroke android:width="2dp" android:color="#ffd700"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1a1a2e"/>
            <stroke android:width="1dp" android:color="#3a3a5a"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a2a4a"/>
            <stroke android:width="1dp" android:color="#4a5a8a"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</selector>
